<script src="js/jquery.min.js"></script>
<script src="js/datatables.min.js"></script>
<script src="js/jquery.fancybox.min.js"></script>
<script src="js/chart.min.js"></script>

<script>
    function removeCluecumberTooltips() {
        document.querySelectorAll('.cluecumber-tooltip').forEach(function (tip) {
            tip.remove();
        });
    }

    function positionCluecumberTooltip(el, tip) {
        const rect = el.getBoundingClientRect();
        tip.style.left = Math.max(8, rect.left) + 'px';
        tip.style.top = (rect.bottom + 6) + 'px';
    }

    /**
     * Lightweight HTML tooltips for report tables and tree view.
     * Re-init after DataTables redraws and bfcache navigation.
     */
    function initCluecumberTooltips() {
        removeCluecumberTooltips();
        document.querySelectorAll('[data-toggle="tooltip"]').forEach(function (el) {
            if (el._cluecumberTooltipInit) {
                return;
            }
            el._cluecumberTooltipInit = true;
            const html = el.getAttribute('data-html') === 'true';
            const content = el.getAttribute('title');
            if (!content) {
                return;
            }
            el.removeAttribute('title');
            el.addEventListener('mouseenter', function () {
                removeCluecumberTooltips();
                const tip = document.createElement('div');
                tip.className = 'cluecumber-tooltip';
                if (html) {
                    tip.innerHTML = content;
                } else {
                    tip.textContent = content;
                }
                document.body.appendChild(tip);
                positionCluecumberTooltip(el, tip);
                el._cluecumberTooltip = tip;
            });
            el.addEventListener('mouseleave', function () {
                if (el._cluecumberTooltip) {
                    el._cluecumberTooltip.remove();
                    el._cluecumberTooltip = null;
                }
            });
        });
    }

    function initCluecumberCollapse() {
        document.addEventListener('click', function (e) {
            if (e.target.closest('.cluecumber-collapsible-copy-action')) {
                return;
            }
            const trigger = e.target.closest('[data-toggle="collapse"]');
            if (!trigger) {
                return;
            }
            const targetSelector = trigger.getAttribute('data-target') || trigger.getAttribute('href');
            if (!targetSelector || !targetSelector.startsWith('#') && !targetSelector.startsWith('.')) {
                return;
            }
            if (targetSelector.startsWith('#')) {
                e.preventDefault();
            }
            const targets = document.querySelectorAll(targetSelector);
            if (targets.length === 0) {
                return;
            }
            const willShow = !Array.from(targets).every(function (target) {
                return target.classList.contains('show');
            });
            targets.forEach(function (target) {
                target.classList.toggle('show', willShow);
                target.dispatchEvent(new Event(willShow ? 'shown.bs.collapse' : 'hidden.bs.collapse', {bubbles: true}));
                if (willShow) {
                    refreshEmbeddedHtmlIframes(target);
                }
            });
            document.querySelectorAll('[data-toggle="collapse"]').forEach(function (control) {
                if ((control.getAttribute('data-target') || control.getAttribute('href')) === targetSelector) {
                    control.setAttribute('aria-expanded', willShow ? 'true' : 'false');
                }
            });
            syncOpenCloseCollapseLabels();
        });
    }

    function syncOpenCloseCollapseLabels(scope) {
        const root = scope && scope.querySelectorAll ? scope : document;
        root.querySelectorAll('[data-cluecumber-open-close]').forEach(function (control) {
            const targetSelector = control.getAttribute('data-target') || control.getAttribute('href');
            if (!targetSelector || !targetSelector.startsWith('#')) {
                return;
            }
            const target = document.querySelector(targetSelector);
            if (!target) {
                return;
            }
            const isOpen = target.classList.contains('show');
            const suffix = control.getAttribute('data-cluecumber-toggle-suffix');
            if (suffix) {
                control.textContent = isOpen ? 'Close ' + suffix : 'Open ' + suffix;
            } else {
                control.textContent = isOpen ? 'Close' : 'Open';
            }
            control.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
    }

    function initCluecumberNav() {
        const toggle = document.querySelector('.cluecumber-nav-toggle');
        const panel = document.getElementById('navbarSupportedContent');
        if (!toggle || !panel) {
            return;
        }
        toggle.addEventListener('click', function () {
            const expanded = panel.classList.toggle('show');
            toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
            document.querySelectorAll('iframe.cluecumber-embedded-view').forEach(function (iframe) {
                if (typeof iframe._cluecumberRefreshEmbeddedView === 'function') {
                    iframe._cluecumberRefreshEmbeddedView();
                }
            });
        });
    }

    function refreshEmbeddedViews() {
        document.querySelectorAll('iframe.cluecumber-embedded-view').forEach(function (iframe) {
            if (typeof iframe._cluecumberRefreshEmbeddedView === 'function') {
                iframe._cluecumberRefreshEmbeddedView();
            }
        });
    }

    function initFirstExceptionContainers() {
        document.querySelectorAll('.firstExceptionContainer').forEach(function(container) {
            const collapseEl = container.querySelector('.collapse');
            const collapseId = collapseEl ? collapseEl.id : null;
            if (!collapseId) {
                return;
            }
            const moreButton = container.querySelector('[data-toggle="collapse"][data-target="#' + collapseId + '"][aria-expanded="false"]');
            if (moreButton) {
                moreButton.addEventListener('click', function() {
                    container.classList.remove('error-show-summary');
                    container.classList.add('error-expanding');
                }, true);
            }
            if (collapseEl) {
                collapseEl.addEventListener('shown.bs.collapse', function() {
                    container.classList.remove('error-expanding');
                });
            }
            container.addEventListener('click', function(e) {
                const button = e.target.closest('[data-toggle="collapse"][data-target="#' + collapseId + '"]');
                if (button && button.getAttribute('aria-expanded') === 'true') {
                    container.classList.remove('error-expanding');
                    container.classList.add('error-show-summary');
                }
            }, true);
        });
    }

    $(document).ready(function () {
            CluecumberTheme.init(function () {
                CluecumberTheme.decorateInternalLinks();
            });

            initCluecumberCollapse();
            initCluecumberNav();
            initFirstExceptionContainers();

            $('.renderAsDataTable').on('draw.dt', function () {
                initCluecumberTooltips();
                CluecumberTheme.decorateInternalLinks();
            }).DataTable({
                "oLanguage": {
                    "sSearch": "Search:"
                },
                "pageLength": 25,
                "responsive": true
            });

            $('.collapse').on('shown.bs.collapse', function (e) {
                $(e.target).find("iframe.embedded-html").each(function (index, iframe) {
                    resizeIframe(iframe);
                });
            });

            $('iframe.embedded-html').each(function (index, iframe) {
                resizeIframe(iframe);
            });

            document.querySelectorAll('iframe.cluecumber-embedded-view').forEach(function (iframe) {
                resizeEmbeddedView(iframe);
            });

            if (document.body.classList.contains('cluecumber-embedded-view-page')) {
                refreshEmbeddedViews();
                window.addEventListener('resize', refreshEmbeddedViews);
            }

            $("a.grouped_elements").fancybox();
            initCluecumberTooltips();

            $(window).on('pagehide', function () {
                removeCluecumberTooltips();
            });

            $(window).on('pageshow', function (event) {
                if (event.originalEvent && event.originalEvent.persisted) {
                    updateDarkLightModeButton(document.documentElement.getAttribute('data-theme') === 'dark');
                    initCluecumberTooltips();
                }
            });

            function toggleVisibilityByStatus(statusText, show) {
                const card = $("#card_" + statusText);
                if (card !== undefined) {
                    if (show) {
                        card.show();
                    } else {
                        card.hide();
                    }
                }

                const row = $(".table-row-" + statusText);
                if (row !== undefined) {
                    if (show) {
                        row.show();
                    } else {
                        row.hide();
                    }
                }
            }

            {% if reportDetails.chartJson is not empty %}
            let cluecumberChart = null;
            const cluecumberChartConfig = {{ reportDetails.chartJson|raw }};
            let cluecumberChartResizeTimer = null;
            let cluecumberChartLastSize = {width: 0, height: 0};
            let cluecumberChartHasRendered = false;

            function scheduleCluecumberChartResize() {
                clearTimeout(cluecumberChartResizeTimer);
                cluecumberChartResizeTimer = setTimeout(renderCluecumberChart, 200);
            }

            function resetCluecumberChartCanvas(canvas) {
                canvas.removeAttribute('width');
                canvas.removeAttribute('height');
                canvas.removeAttribute('style');
            }

            function buildCluecumberChartConfig() {
                const chartConfig = JSON.parse(JSON.stringify(cluecumberChartConfig));
                chartConfig.options = chartConfig.options || {};
                const isPieChart = chartConfig.type === "pie";

                chartConfig.options.responsive = true;
                if (isPieChart) {
                    chartConfig.options.maintainAspectRatio = true;
                    chartConfig.options.aspectRatio = 1;
                    chartConfig.options.layout = chartConfig.options.layout || {};
                    chartConfig.options.layout.padding = 8;
                    chartConfig.options.onClick = function (evt, elements) {
                        if (elements.length === 0) return;
                        const label = this.data.labels[elements[0].index];
                        if (label == null) return;
                        const anchorId = 'anchor-' + label;
                        if (document.getElementById(anchorId)) {
                            document.location.hash = anchorId;
                        }
                    };
                    chartConfig.options.onHover = function (evt, elements) {
                        evt.native.target.style.cursor = elements.length > 0 ? 'pointer' : 'default';
                    };
                } else {
                    chartConfig.options.maintainAspectRatio = false;
                    {% if reportDetails.chartUrlLookup is not empty %}
                    const chartUrls = {
                        {% for entry in reportDetails.chartUrlLookup %}
                        "{{ entry.key|escape('js') }}": "{{ entry.value }}",
                        {% endfor %}
                    };
                    chartConfig.options.onClick = function (evt, elements) {
                        if (elements.length === 0) return;
                        const index = elements[0].index;
                        const label = this.data.labels[index];
                        if (label == null) return;
                        const urlSnippet = chartUrls[label];
                        if (urlSnippet == null) return;
                        window.location.href = CluecumberTheme.hrefWithTheme(urlSnippet);
                    };
                    {% endif %}
                }

                chartConfig.options.plugins = chartConfig.options.plugins || {};
                chartConfig.options.plugins.legend = chartConfig.options.plugins.legend || {};
                chartConfig.options.plugins.legend.labels = chartConfig.options.plugins.legend.labels || {};
                chartConfig.options.plugins.legend.display = false;

                chartConfig.options.animation = false;

                return chartConfig;
            }

            function destroyCluecumberChart() {
                if (cluecumberChart) {
                    cluecumberChart.destroy();
                    cluecumberChart = null;
                }
            }

            function renderCluecumberChart() {
                requestAnimationFrame(function () {
                    const canvas = document.getElementById('chart-area');
                    const holder = document.getElementById('canvas-holder');
                    if (!canvas || !holder) {
                        return;
                    }

                    const width = holder.clientWidth;
                    const height = holder.clientHeight;
                    if (width <= 0 || height <= 0) {
                        if (cluecumberChartHasRendered) {
                            scheduleCluecumberChartResize();
                        } else {
                            requestAnimationFrame(renderCluecumberChart);
                        }
                        return;
                    }

                    if (cluecumberChart
                        && cluecumberChartLastSize.width === width
                        && cluecumberChartLastSize.height === height) {
                        return;
                    }

                    const chartConfig = buildCluecumberChartConfig();
                    const isPieChart = chartConfig.type === "pie";

                    holder.classList.toggle('chart-pie', isPieChart);

                    destroyCluecumberChart();
                    resetCluecumberChartCanvas(canvas);

                    cluecumberChartLastSize = {width: width, height: height};
                    cluecumberChart = new Chart(canvas, chartConfig);
                    cluecumberChartHasRendered = true;
                });
            }

            renderCluecumberChart();
            $(window).on('resize', function () {
                if (cluecumberChartHasRendered) {
                    scheduleCluecumberChartResize();
                }
            });
            if (typeof ResizeObserver !== 'undefined') {
                const chartHolder = document.getElementById('canvas-holder');
                if (chartHolder) {
                    new ResizeObserver(function () {
                        if (cluecumberChartHasRendered) {
                            scheduleCluecumberChartResize();
                        }
                    }).observe(chartHolder);
                }
            }
            {% endif %}

            updateDarkLightModeButton(document.documentElement.getAttribute('data-theme') === 'dark');

            const darkModeSwitch = document.getElementById('dark-light-mode-switch');
            if (darkModeSwitch) {
                darkModeSwitch.addEventListener('click', function () {
                    CluecumberTheme.toggle();
                });
            }
        }
    );

    function updateDarkLightModeButton(isDarkMode) {
        const button = document.getElementById('dark-light-mode-switch');
        if (!button) {
            return;
        }
        if (isDarkMode) {
            button.setAttribute('aria-label', 'Switch to light mode');
            button.title = 'Light mode';
            button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1.15em" height="1.15em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 18a1 1 0 0 1 0 2 1 1 0 0 1 0-2zm0-14a1 1 0 0 1 0 2 1 1 0 0 1 0-2zm8 7a1 1 0 0 1 2 0 1 1 0 0 1-2 0zM2 12a1 1 0 0 1 2 0 1 1 0 0 1-2 0zm16.95 5.95a1 1 0 0 1 1.41 1.41 1 1 0 0 1-1.41-1.41zm-13.9-13.9a1 1 0 0 1 1.41 1.41 1 1 0 0 1-1.41-1.41zM20.54 6.46a1 1 0 0 1 1.41-1.41 1 1 0 0 1-1.41 1.41zM4.05 17.95a1 1 0 0 1 1.41-1.41 1 1 0 0 1-1.41 1.41zM12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10z"/></svg>';
        } else {
            button.setAttribute('aria-label', 'Switch to dark mode');
            button.title = 'Dark mode';
            button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1.15em" height="1.15em" aria-hidden="true" focusable="false"><path fill="currentColor" d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
        }
    }

    function resizeEmbeddedView(iframe) {
        function availableHeight() {
            var main = iframe.closest('main');
            if (main) {
                return main.clientHeight;
            }
            return window.innerHeight;
        }

        function applyHeight() {
            var available = availableHeight();
            try {
                var doc = iframe.contentWindow.document;
                var contentHeight = Math.max(
                    doc.documentElement.scrollHeight,
                    doc.body ? doc.body.scrollHeight : 0
                );
                iframe.style.height = Math.min(contentHeight + 25, available) + 'px';
            } catch (error) {
                iframe.style.height = available + 'px';
            }
        }

        function bind() {
            applyHeight();
        }

        iframe._cluecumberRefreshEmbeddedView = applyHeight;

        try {
            var doc = iframe.contentDocument || iframe.contentWindow.document;
            if (doc && doc.readyState === 'complete') {
                bind();
            } else {
                iframe.addEventListener('load', bind, {once: true});
            }
        } catch (error) {
            iframe.addEventListener('load', bind, {once: true});
        }
    }

    function attachmentIframeIsVisible(iframe) {
        const collapse = iframe.closest('.collapse');
        if (collapse && !collapse.classList.contains('show')) {
            return false;
        }
        return iframe.offsetParent !== null || (collapse !== null && collapse.classList.contains('show'));
    }

    function measureIframeContentHeight(doc) {
        const html = doc.documentElement;
        const body = doc.body;
        const heights = [
            html ? html.scrollHeight : 0,
            html ? html.offsetHeight : 0,
            body ? body.scrollHeight : 0,
            body ? body.offsetHeight : 0
        ];
        if (body) {
            const bodyTop = body.getBoundingClientRect().top;
            body.querySelectorAll('table').forEach(function (table) {
                const rect = table.getBoundingClientRect();
                heights.push(Math.ceil(rect.bottom - bodyTop));
            });
            Array.prototype.forEach.call(body.children, function (child) {
                heights.push(child.offsetTop + child.offsetHeight);
            });
        }
        return Math.max.apply(null, heights);
    }

    function embeddedHtmlProbeWidth(iframe) {
        const width = iframe.getBoundingClientRect().width;
        if (width > 0) {
            return width;
        }
        const collapse = iframe.closest('.collapse');
        if (collapse) {
            const collapseWidth = collapse.getBoundingClientRect().width;
            if (collapseWidth > 0) {
                return collapseWidth;
            }
        }
        const attachment = iframe.closest('.scenarioAttachment');
        if (attachment) {
            const attachmentWidth = attachment.getBoundingClientRect().width;
            if (attachmentWidth > 0) {
                return attachmentWidth;
            }
        }
        return 0;
    }

    const cluecumberEmbeddedHtmlMarkupCache = new Map();

    function resolveEmbeddedHtmlSourceUrl(iframe) {
        const src = iframe.getAttribute('src');
        if (!src) {
            return null;
        }
        try {
            return new URL(src, document.baseURI).href;
        } catch (error) {
            return null;
        }
    }

    function fetchEmbeddedHtmlMarkup(iframe) {
        const url = resolveEmbeddedHtmlSourceUrl(iframe);
        if (!url) {
            return Promise.resolve('');
        }
        if (cluecumberEmbeddedHtmlMarkupCache.has(url)) {
            return Promise.resolve(cluecumberEmbeddedHtmlMarkupCache.get(url));
        }
        return fetch(url).then(function (response) {
            if (!response.ok) {
                return '';
            }
            return response.text();
        }).then(function (markup) {
            cluecumberEmbeddedHtmlMarkupCache.set(url, markup);
            return markup;
        }).catch(function () {
            return '';
        });
    }

    function measureEmbeddedHtmlMarkupHeight(iframe, markup) {
        if (!markup || !markup.trim()) {
            return 0;
        }
        const probeWidth = embeddedHtmlProbeWidth(iframe);
        if (probeWidth <= 0) {
            return 0;
        }
        const probe = document.createElement('div');
        probe.className = 'cluecumber-embedded-html-probe';
        probe.setAttribute('aria-hidden', 'true');
        probe.style.cssText = 'position:absolute;left:-9999px;top:0;visibility:hidden;box-sizing:border-box;width:'
            + probeWidth + 'px;';
        probe.innerHTML = markup;
        document.body.appendChild(probe);
        const probeHeight = Math.ceil(probe.scrollHeight);
        probe.remove();
        return probeHeight > 0 ? probeHeight : 0;
    }

    function embeddedHtmlBodyMarkup(doc) {
        if (!doc || !doc.body) {
            return '';
        }
        return doc.body.innerHTML ? doc.body.innerHTML.trim() : '';
    }

    function embeddedHtmlMarkupFromTemplate(iframe) {
        const attachment = iframe.closest('.scenarioAttachment');
        if (!attachment) {
            return '';
        }
        const template = attachment.querySelector('template.cluecumber-embedded-html-source');
        if (!template) {
            return '';
        }
        const markup = template.innerHTML;
        return markup ? markup.trim() : '';
    }

    function measureEmbeddedHtmlContentHeight(iframe, doc, markup) {
        const probeWidth = embeddedHtmlProbeWidth(iframe);
        if (probeWidth <= 0) {
            return 0;
        }
        const fromMarkup = markup || embeddedHtmlBodyMarkup(doc);
        if (fromMarkup) {
            const probeHeight = measureEmbeddedHtmlMarkupHeight(iframe, fromMarkup);
            if (probeHeight > 0) {
                return probeHeight;
            }
        }
        if (doc) {
            return measureIframeContentHeight(doc);
        }
        return 0;
    }

    function attachmentHtmlMaxHeightPx() {
        const raw = getComputedStyle(document.documentElement)
            .getPropertyValue('--cluecumber-attachment-content-max-height')
            .trim();
        if (!raw) {
            return 384;
        }
        const value = parseFloat(raw);
        if (Number.isNaN(value)) {
            return 384;
        }
        if (raw.endsWith('rem')) {
            const rootFont = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
            return value * rootFont;
        }
        return value;
    }

    function ensureEmbeddedHtmlDocumentStyles(doc) {
        if (!doc || !doc.documentElement) {
            return;
        }
        let head = doc.head;
        if (!head) {
            head = doc.createElement('head');
            const body = doc.body;
            if (body) {
                doc.documentElement.insertBefore(head, body);
            } else {
                doc.documentElement.appendChild(head);
            }
        }
        if (doc.getElementById('cluecumber-embedded-html-reset')) {
            return;
        }
        const style = doc.createElement('style');
        style.id = 'cluecumber-embedded-html-reset';
        style.textContent = 'html,body{margin:0;padding:0;}';
        head.appendChild(style);
    }

    function resolveEmbeddedHtmlIframeHeight(iframe, doc, markup) {
        const natural = measureEmbeddedHtmlContentHeight(iframe, doc, markup);
        const maxPx = attachmentHtmlMaxHeightPx();
        const slack = 48;
        if (natural <= 0) {
            return {applied: false, needsRetry: embeddedHtmlProbeWidth(iframe) <= 0};
        }
        const content = natural + slack;
        if (content <= maxPx) {
            return {applied: true, height: content, capped: false, needsRetry: false};
        }
        return {applied: true, height: maxPx, capped: true, needsRetry: false};
    }

    function applyEmbeddedHtmlIframeHeight(iframe, doc, markup) {
        if (doc) {
            ensureEmbeddedHtmlDocumentStyles(doc);
        }
        const resolved = resolveEmbeddedHtmlIframeHeight(iframe, doc, markup);
        if (!resolved.applied) {
            return false;
        }
        iframe.style.height = resolved.height + 'px';
        iframe.style.minHeight = '0';
        iframe.classList.add('is-sized');
        iframe.classList.toggle('is-capped', resolved.capped);
        return true;
    }

    function applyEmbeddedHtmlIframeHeightFromSources(iframe, doc, markup) {
        if (applyEmbeddedHtmlIframeHeight(iframe, doc, markup)) {
            return true;
        }
        return applyEmbeddedHtmlIframeHeight(iframe, null, markup);
    }

    function refreshEmbeddedHtmlIframes(root) {
        const scope = root && root.querySelectorAll ? root : document;
        const iframes = root && root.querySelectorAll
            ? root.querySelectorAll('iframe.embedded-html')
            : scope.querySelectorAll('iframe.embedded-html');
        iframes.forEach(function (iframe) {
            if (typeof iframe._cluecumberApplyEmbeddedHtmlHeight === 'function') {
                iframe._cluecumberApplyEmbeddedHtmlHeight();
            } else {
                resizeIframe(iframe);
            }
        });
    }

    function resizeIframe(iframe) {
        function applyHeightWithMarkup(markup) {
            if (!attachmentIframeIsVisible(iframe)) {
                return;
            }
            let doc = null;
            try {
                doc = iframe.contentWindow.document;
            } catch (ignored) {
            }
            const bodyMarkup = doc ? embeddedHtmlBodyMarkup(doc) : '';
            const combined = bodyMarkup || markup || '';
            if (!applyEmbeddedHtmlIframeHeightFromSources(iframe, doc, combined)) {
                if (embeddedHtmlProbeWidth(iframe) <= 0) {
                    requestAnimationFrame(function () {
                        applyHeightWithMarkup(combined);
                    });
                }
            }
        }

        function applyHeight() {
            if (!attachmentIframeIsVisible(iframe)) {
                return;
            }
            let doc = null;
            try {
                doc = iframe.contentWindow.document;
            } catch (ignored) {
            }
            if (doc && doc.readyState !== 'complete') {
                return;
            }
            const bodyMarkup = doc ? embeddedHtmlBodyMarkup(doc) : '';
            if (bodyMarkup) {
                applyHeightWithMarkup(bodyMarkup);
                return;
            }
            const templateMarkup = embeddedHtmlMarkupFromTemplate(iframe);
            if (templateMarkup) {
                applyHeightWithMarkup(templateMarkup);
                return;
            }
            fetchEmbeddedHtmlMarkup(iframe).then(function (markup) {
                if (!markup.trim()) {
                    return;
                }
                applyHeightWithMarkup(markup);
            });
        }

        iframe._cluecumberApplyEmbeddedHtmlHeight = applyHeight;

        if (iframe.dataset.cluecumberResizeBound === 'true') {
            applyHeight();
            return;
        }

        function bind() {
            applyHeight();
            iframe.dataset.cluecumberResizeBound = 'true';
        }

        iframe.addEventListener('load', applyHeight);

        try {
            const doc = iframe.contentDocument || iframe.contentWindow.document;
            if (doc && doc.readyState === 'complete') {
                bind();
            } else {
                iframe.addEventListener('load', bind, {once: true});
            }
        } catch (e) {
            iframe.addEventListener('load', bind, {once: true});
        }
    }

    function copyText(elementId) {
        let text = document.getElementById(elementId).innerText;
        if (text.startsWith("Copy")) {
            text = text.substring(4).trim();
        }
        navigator.clipboard.writeText(text)
            .catch((error) => {
                console.error('Failed to copy text from ' + elementId + ':', error);
            });
    }
</script>
